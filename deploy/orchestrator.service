[Unit]
Description=orchestrator - autonomous PO/Dev loop over Claude Code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/orchestrator.env
ExecStart=/opt/orchestrator/bin/orchestrator
Restart=on-failure
RestartSec=30

# Hardening: adjust WorkingDirectory/User if the deploying account differs.
# WorkingDirectory is not required (ORCH_REPO_DIR/ORCH_DATA_DIR are set via
# the environment file), but set it if you rely on relative paths.
# User=orchestrator
# WorkingDirectory=/opt/orchestrator

[Install]
WantedBy=multi-user.target
