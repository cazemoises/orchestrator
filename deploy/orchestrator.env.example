# Copy this file to /etc/orchestrator.env on the VM and fill in the real
# values. This file is NOT committed with real secrets - it is a template.
# Referenced by deploy/orchestrator.service via EnvironmentFile=.

# Required. Output of `claude setup-token` run once on the VM (see
# deploy/setup-runner.md and the main README's "Autenticação" section).
CLAUDE_CODE_OAUTH_TOKEN=

# Target repo the Dev/PO agents operate on. This orchestrator instance is
# meant to drive the pdf-reader backend build-out.
ORCH_REPO_DIR=/caminho/pdf-reader/backend

# Where the orchestrator's persisted memory (vision/state/backlog/history/
# run_state) lives. Must be prepared once by hand — see README.md
# "Preparando data/ para um projeto novo" - before the first run.
ORCH_DATA_DIR=/opt/orchestrator/data

# Optional tuning (defaults shown are the code defaults, not enforced here):
# ORCH_MAX_ATTEMPTS_PER_TASK=3
# ORCH_MAX_TASKS_PER_CYCLE=0
ORCH_DEV_ALLOWED_TOOLS=Bash,Edit,Read,Write,Glob,Grep
# ORCH_PO_MODEL=
# ORCH_DEV_MODEL=
# ORCH_NOTIFY_WEBHOOK=
