# Local execution env vars (WSL2/Linux on your dev machine - the
# orchestrator no longer runs on the VM, see deploy/setup-runner.md).
# Copy this somewhere like ~/.config/orchestrator.env and `set -a; source
# .../orchestrator.env; set +a` before running ./bin/orchestrator, or export
# these directly in your shell profile. This file is NOT committed with
# real secrets - it is a template.

# Required. Output of `claude setup-token` (see README.md "Autenticação").
CLAUDE_CODE_OAUTH_TOKEN=

# Target repo the Dev/PO agents operate on: your LOCAL clone of pdf-reader,
# not a VM path. Code only reaches the VM via commit+push -> pdf-reader's
# own CI/CD (self-hosted runner, see ../pdf-reader/deploy/setup-runner.md).
ORCH_REPO_DIR=/home/you/projects/pdf-reader/backend

# Where the orchestrator's persisted memory (vision/state/backlog/history/
# run_state) lives. Must be prepared once by hand — see README.md
# "Preparando data/ para um projeto novo" - before the first run.
ORCH_DATA_DIR=/home/you/projects/orchestrator/data

# Sanity check run in ORCH_REPO_DIR before every commit+push, right after
# the PO accepts a task. Empty skips it (not recommended). Adjust as the
# backlog moves between backend/frontend/extractor.
ORCH_LOCAL_VERIFY_COMMAND=go build ./... && go vet ./...

# Optional tuning (defaults shown are the code defaults, not enforced here):
# ORCH_MAX_ATTEMPTS_PER_TASK=3
# ORCH_MAX_TASKS_PER_CYCLE=0
ORCH_DEV_ALLOWED_TOOLS=Bash,Edit,Read,Write,Glob,Grep
# ORCH_GIT_COMMIT_PREFIX=feat:
# ORCH_PO_MODEL=
# ORCH_DEV_MODEL=
# ORCH_NOTIFY_WEBHOOK=
